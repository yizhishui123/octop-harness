# octop-harness chat demo — provider credentials (never commit real keys)
#
# 火山引擎 Ark（推荐，OpenAI 兼容协议）：
#   设置 VOLCES_API_KEY 后，base_url（https://ark.cn-beijing.volces.com/api/v3）
#   与模型目录由内置预设自动提供。注意 VOLCES_API_KEY 同时命中三个预设
#   （volcengine-cn / -codingplan / -agentplan），所以请用 HARNESS_DEFAULT_MODEL
#   显式钉住要用的模型：
VOLCES_API_KEY=sk-xxx
HARNESS_DEFAULT_MODEL=volcengine-cn/doubao-seed-2-1-pro-260915

# 如果你的 Ark 账号用的是推理接入点 ID（ep-xxxxxxxx），走这条自定义端点写法：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_MODEL_NAME=ep-xxxxxxxx

# 其它写法（按需选用）：
#   HARNESS_PROVIDER_<NAME>_API_KEY=sk-xxx      # 自定义 provider
#   HARNESS_PROVIDER_<NAME>_BASE_URL=https://...
#   HARNESS_PROVIDER_<NAME>_PROTOCOL=openai     # openai / anthropic / bedrock
